# ------------------------------------------------------------------
# Food Guard AI — environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=foodguard
POSTGRES_PASSWORD=foodguard-dev-password
POSTGRES_DB=foodguard
DATABASE_URL=postgresql+psycopg://foodguard:foodguard-dev-password@db:5432/foodguard

# --- Backend ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost"]
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- AI ---
AI_PROVIDER=ollama            # ollama | disabled
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Host port overrides (only relevant on a server that runs its own nginx
# in front of other sites — see deploy/install-vhost.sh) ---
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- SMTP (password reset emails; logs to console if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@foodguard.ai
