# ------------------------------------------------------------------
# Food Guard AI — environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=foodguard
POSTGRES_PASSWORD=foodguard-dev-password
POSTGRES_DB=foodguard
DATABASE_URL=postgresql+psycopg://foodguard:foodguard-dev-password@db:5432/foodguard

# --- Backend ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost"]
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- AI ---
AI_PROVIDER=ollama            # ollama | disabled
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Host port overrides (only relevant on a server that runs its own nginx
# in front of other sites — see deploy/install-vhost.sh) ---
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Production tuning ---
# Number of uvicorn worker processes. Keep at 1 on shared/modest servers;
# raise on a dedicated box with spare CPU (roughly 2x vCPU cores + 1).
API_WORKERS=1

# Per-container memory/CPU caps, so nothing here can starve other workloads
# on a shared host (or each other). Raise these if the box is dedicated and
# you want more headroom — see docs/OPERATIONS.md for tuning guidance.
DB_MEM_LIMIT=1g
DB_CPU_LIMIT=1.0
API_MEM_LIMIT=1g
API_CPU_LIMIT=1.0
WEB_MEM_LIMIT=512m
WEB_CPU_LIMIT=0.5
OLLAMA_MEM_LIMIT=4g
OLLAMA_CPU_LIMIT=2.0

# --- Backups (see deploy/backup.sh, installed to run nightly via cron) ---
BACKUP_RETENTION_DAYS=14

# --- Health monitoring (see deploy/healthcheck-alert.sh) ---
# Public URL the alert script checks; leave blank to check the API
# container directly over loopback instead.
HEALTHCHECK_URL=
# Email address to notify on repeated health-check failures (uses the SMTP
# settings above; if SMTP_HOST is blank, alerts just print to the cron log).
ALERT_EMAIL=

# --- SMTP (password reset emails; logs to console if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@foodguard.ai

# --- Billing (Stripe subscriptions; leave blank to run without real payments —
# the plans/current-subscription UI still works, checkout just explains it
# isn't configured yet. See docs/INSTALL.md "Billing" section.) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- EcoCash (manual mobile-money payments, no API integration exists —
# customers pay this number out of band and a Super Admin approves the
# payment in-app under EcoCash Payments) ---
ECOCASH_MERCHANT_NUMBER=0784457922
